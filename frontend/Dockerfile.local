# DevForge frontend dev image — Next.js 16 dev server with HMR.
#
# Source bind-mounted at runtime; node_modules lives on a named volume.
# We deliberately don't `npm install` at build time. Pre-installing baked
# ~850 MB into the image, which then had to be *copied* into the empty
# `frontend_node_modules` named volume on first attach (slow on Apple
# Silicon's grpcfuse). Instead, the boot-time CMD's `npm install`
# populates the empty volume directly, and the `npm_cache` named volume
# keeps tarball downloads around so subsequent boots are fast.
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=development \
    HOSTNAME=0.0.0.0

EXPOSE 3000

# Boot-time: install deps into the node_modules volume (empty on first
# attach, persisted thereafter), then start the dev server with HMR.
CMD ["sh", "-c", "npm install && exec npm run dev"]
