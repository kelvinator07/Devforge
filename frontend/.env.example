# Copy to .env.local before `npm run dev`.
# Get Clerk keys from https://dashboard.clerk.com — create a new application.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where the control plane lives. Match what `./scripts/local_dev.sh serve` prints.
NEXT_PUBLIC_DEVFORGE_API=http://localhost:8001

# Optional — enables the "view trace ↗" button on /jobs/[id]. Find your project
# id by opening any trace on cloud.langfuse.com — the URL is
# /project/<this>/traces/<trace_id>.
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=
NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub App slug — the lowercase URL fragment from your App's settings page,
# e.g. https://github.com/apps/<this>. Used by the dashboard's "Connect GitHub
# repo" button to redirect the user to the install page. Public; safe in the
# browser bundle. The App's Setup URL must point at <frontend>/connect/callback.
NEXT_PUBLIC_GITHUB_APP_SLUG=devforge-kelvinator07

# After #B2 the admin token is no longer shipped to the browser. Browser-driven
# onboarding now creates tenants automatically through POST /tenants/connect
# (called from /connect/callback after the user installs the GitHub App).
# The legacy `scripts/link_tenant_clerk_identity.py` flow is kept as a backfill
# escape hatch; you shouldn't need it for new sign-ups.
